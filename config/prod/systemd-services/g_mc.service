[Unit]
Description=Runner for the Minecraft Server

# Require the database to have started so that block-logging works
After=mysql.service     
# If the database goes down, then we want to stop the minecraft server too
# In mysql's config, we ensure that g_mc.service is stopped fully before mysql.service begins to stop 
Requires=mysql.service  
# When mysql.service stops, this g_mc.service stops too. Ordering is defined in the mysql config
BindsTo=mysql.service    

# Limit to 2 restarts (in a 5m period), after that mark as failed
StartLimitIntervalSec=5m  
StartLimitBurst=2

# Status logging
# We need to do it like this as OnFailure cannot run bash
OnFailure=g_service_failed@Minecraft-g_mc.service

[Service]
User=g_mc
Group=g_mc
WorkingDirectory=/var/lib/g_mc
ExecStart=/usr/bin/java -Xms1G -Xmx3G \
-XX:+UseG1GC \
-XX:+ParallelRefProcEnabled \
-XX:MaxGCPauseMillis=200 \
-XX:+UnlockExperimentalVMOptions \
-XX:+DisableExplicitGC \
-XX:+AlwaysPreTouch \
-XX:G1NewSizePercent=30 \
-XX:G1MaxNewSizePercent=40 \
-XX:G1HeapRegionSize=8M \
-XX:G1ReservePercent=20 \
-XX:G1MixedGCCountTarget=4 \
-XX:InitiatingHeapOccupancyPercent=15 \
-XX:G1MixedGCLiveThresholdPercent=90 \
-XX:+PerfDisableSharedMem \
-XX:MaxTenuringThreshold=1 \
-jar /var/lib/g_mc/minecraft_server.jar nogui
ExecStop=/opt/infra/.venv/bin/python3 /opt/infra/scripts/g_mc/service_stop.py

# Get environment variables (g_mc_g_web_minecraft.env supplies ExecStop's console socket port/key)
EnvironmentFile=/etc/g-demmain/common.env
EnvironmentFile=/etc/g-demmain/g_mc_g_web_minecraft.env
EnvironmentFile=/etc/g-demmain/g_mc_g_discord_minecraft.env

# Status logging
ExecStartPost=/opt/infra/.venv/bin/python3 /opt/infra/scripts/webhooks.py status Minecraft g_mc starting
ExecStopPost=/opt/infra/.venv/bin/python3 /opt/infra/scripts/webhooks.py status Minecraft g_mc stopped

# Restart only when it crashes, not on /stop
Restart=on-failure
RestartSec=10

# How long to wait after ExecStop before escalating to SIGKILL - should only be hit
# if the console socket stop failed
TimeoutStopSec=90

# Any files created will be read/writable by the user g_mc and the group g_mc
UMask=0002

# Security hardening:
#PrivateTmp=true
# Blocks write access to certain folders
#ProtectSystem=full   
# TODO: Find a way to retain hardening while allowing fuse, or otherwise find an alternative for exposing the data that currently uses fuse

# Enable monitoring of disk io by other processes (g_monitor)
IOAccounting=yes 

[Install]
WantedBy=multi-user.target
