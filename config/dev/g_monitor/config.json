{
  "cgroups": [
    "system.slice/g_mc.service",
    "system.slice/dbus.service",   
    "system.slice/bluetooth.service"
  ],
  "retention": [[2, 50, "snapshot"], [10, 5, "aggregate"], [20, null, "aggregate"], [4, 20, "snapshot"]],
  "recordFolder": "scripts/g_monitor",
  "ramWarnThreshold": 0.9,
  "diskWarnThreshold": 0.9,
  "diskWarnMounts": ["/"]
}
