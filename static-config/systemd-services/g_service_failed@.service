# A service to sent a status=crashed webhook. We need this as OnFailed cannot directly run python.
# The parameter is expected to be <readable_name>-<service_name>, e.g. Minecraft-g_mc.
[Unit]
Description=Failure handler that calls the failure webhook

[Service]
Type=oneshot

# Get environment variables (we need this to get the github web url)
EnvironmentFile=/etc/g-demmain/common.env

# Separate paramaters up and run
ExecStart=/bin/bash -c 'IFS="-"; set -- "%i"; /opt/infra/.venv/bin/python3 /opt/infra/scripts/webhooks.py status $@ crashed'
