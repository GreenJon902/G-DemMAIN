{
  "name": "@g/com",
  "version": "0.1.0",
  "exports": {
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./prisma/*": {
      "types": "./dist/generated/prisma/*.d.ts",
      "default": "./dist/generated/prisma/*.js"
    }
  },
  "scripts": {
    "build": "npm run build:_chk && npm run build:_prs && npm run build:_tsc",
    "build:_chk": "grep -qF '@@unique([event_id, related_event_id])' prisma/schema.prisma || (echo 'ERROR: hd_event_event_rea is missing @@unique([event_id, related_event_id]) in prisma/schema.prisma — add it manually after schema:pull' && exit 1)",
    "build:_prs": "npx prisma generate",
    "build:_tsc": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "schema:pull": "npx prisma db pull"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "type-fest": "^5.7.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "iron-session": "^8.0.4",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
