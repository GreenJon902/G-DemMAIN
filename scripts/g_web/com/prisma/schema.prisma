  username          String                 @unique(map: "username") @db.VarChar(50)
  password_hash     String                 @db.VarChar(255)
  panel_permission  user_panel_permission?
  hisdoc_permission user_hisdoc_permission @default(viewer)
  tfa_secret        String?                @db.VarChar(32)
  hd_changelog      hd_changelog[]
  hd_event          hd_event[]
  hd_person         hd_person?
}

view hd_event_event_rea {
  event_id         Int @default(0)
  related_event_id Int @default(0)
  soft_deleted     Int @default(0) @db.TinyInt

  @@unique([event_id, related_event_id])
}

