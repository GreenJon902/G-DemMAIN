  event_date_time_offset                                           Int                        @db.SmallInt
  event_date_units                                                 hd_event_event_date_units?
  event_date_diff                                                  BigInt?                    @db.UnsignedBigInt
  event_date2                                                      BigInt?                    @db.UnsignedBigInt
  sort_key                                                         BigInt?
  soft_deleted                                                     Boolean                    @default(false)
  user                                                             user                       @relation(fields: [posted_by_user_id], references: [id], onUpdate: Restrict, map: "hd_event_ibfk_1")
  hd_event_event_wri_hd_event_event_wri_event_idTohd_event         hd_event_event_wri[]       @relation("hd_event_event_wri_event_idTohd_event")
  hd_event_event_wri_hd_event_event_wri_related_event_idTohd_event hd_event_event_wri[]       @relation("hd_event_event_wri_related_event_idTohd_event")
  hd_event_person                                                  hd_event_person[]
  hd_event_tag                                                     hd_event_tag[]

  @@index([sort_key], map: "idx_hd_event_sort")
  @@index([posted_by_user_id], map: "posted_by_user_id")
}

