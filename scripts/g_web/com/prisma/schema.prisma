/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model hd_changelog {
  id             Int                 @id @default(autoincrement())
  user_id        Int?
  message        String              @db.LongText
  created_at     DateTime            @default(now()) @db.DateTime(0)
  what           hd_changelog_what
  entity_id      Int
  old_values     String?             @db.LongText
  new_values     String?             @db.LongText
  action         hd_changelog_action
  schema_version Int
  soft_deleted   Boolean             @default(false)
  user           user?               @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "hd_changelog_ibfk_1")

  @@index([user_id], map: "user_id")
  @@index([what, entity_id], map: "idx_hd_changelog_entity")
}

