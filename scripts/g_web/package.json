{
    "name": "@g_web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev":       "npm run build -w @g/com && concurrently --kill-others -n COM,NXT,MCC \"npm run watch -w @g/com\" \"npm run dev -w @g/nxt\" \"npm run dev -w @g/mcc\"",
        "build":     "npm run build --workspaces",
        "lint":      "eslint",
        "typecheck": "tsc --build --noEmit nxt/tsconfig.json mcc/tsconfig.json"
    },
    "workspaces": [
        "com",
        "mcc",
        "nxt"
    ],
    "devDependencies": {
        "@types/node": "^20.19.43",
        "concurrently": "^9.2.1",
        "eslint": "^9",
        "eslint-config-next": "16.2.4",
        "eslint-plugin-tailwindcss": "^3.18.3",
        "typescript": "^5"
    }
}
