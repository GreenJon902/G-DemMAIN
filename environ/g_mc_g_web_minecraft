MINECRAFT_PORT
# The port to open the actual minecraft "server" on. So the one that we expose to the internet and players connect to.

MINECRAFT_RCON_PORT
# The port we open internally for management via RCON.

MINECRAFT_RCON_PASSWORD
# The password used to authenticate with RCON.

MINECRAFT_LOG_PATH
# The path to the folder where minecraft logs are stored.

MINECRAFT_MONITOR_CONSOLE_AUTH_KEY
# The shared key g_mc_monitor's console socket requires clients to present.

MINECRAFT_MONITOR_CHAT_AUTH_KEY
# The shared key g_mc_monitor's chat socket requires clients to present.

MINECRAFT_MONITOR_CONSOLE_PORT
# The port g_mc_monitor's console socket listens on (see doc/G-DemMAIN Monitor Mod.md). Loopback-only, so no firewall rule is needed.

MINECRAFT_MONITOR_CHAT_PORT
# The port g_mc_monitor's chat socket listens on (see doc/G-DemMAIN Monitor Mod.md). Loopback-only, so no firewall rule is needed.


